<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #101512;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.CadastroController">

    <children>
        <HBox alignment="CENTER" spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Painel lateral -->
            <VBox alignment="CENTER" minWidth="390.0" prefWidth="390.0" spacing="22.0" style="-fx-background-color: #17231c;" HBox.hgrow="NEVER">

                <padding>
                    <Insets bottom="40" left="35" right="35" top="40" />
                </padding>

                <Region VBox.vgrow="ALWAYS" />

                <Label text="StockWatch" textFill="#42e878">
                    <font>
                        <Font name="System Bold" size="34" />
                    </font>
                </Label>

                <Label alignment="CENTER" text="CONTROLE INTELIGENTE DE ESTOQUE" textFill="#a2b5a7" wrapText="true">
                    <font>
                        <Font size="12" />
                    </font>
                </Label>

                <Region prefHeight="10" />

                <Label alignment="CENTER" text="Organize. Monitore. Cresça." textFill="#ffffff" wrapText="true">
                    <font>
                        <Font name="System Bold" size="22" />
                    </font>
                </Label>

                <Label alignment="CENTER" lineSpacing="6.0" text="Gerencie produtos, acompanhe validades e mantenha seu estoque sob controle." textAlignment="CENTER" textFill="#a2b5a7" wrapText="true">
                    <font>
                        <Font size="14" />
                    </font>
                </Label>

                <Region VBox.vgrow="ALWAYS" />

                <Label text="STOCKWATCH • GESTÃO DE ESTOQUE" textFill="#607568">
                    <font>
                        <Font size="10" />
                    </font>
                </Label>
            </VBox>

            <!-- Formulário de cadastro -->
            <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS">

                <padding>
                    <Insets bottom="35" left="65" right="65" top="35" />
                </padding>

                <VBox alignment="CENTER_LEFT" maxWidth="420.0" spacing="7.0">

                    <Label text="Criar conta" textFill="#ffffff">
                        <font>
                            <Font name="System Bold" size="30" />
                        </font>
                    </Label>

                    <Label text="Preencha seus dados para começar." textFill="#9ba89e">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                </VBox>

                <Region prefHeight="2.0" />

                <VBox maxWidth="420.0" spacing="6.0">
                    <Label text="Nome de usuário" textFill="#dce7df" />
                    <TextField fx:id="txtUsuario" prefHeight="43.0" promptText="Escolha um usuário" style="-fx-background-color: #1b251f;                                       -fx-text-fill: white;                                       -fx-prompt-text-fill: #718077;                                       -fx-border-color: #35453a;                                       -fx-border-radius: 6;                                       -fx-background-radius: 6;                                       -fx-padding: 0 12;" />
                </VBox>

                <VBox maxWidth="420.0" spacing="6.0">
                    <Label text="E-mail" textFill="#dce7df" />
                    <TextField fx:id="txtEmail" prefHeight="43.0" promptText="exemplo@email.com" style="-fx-background-color: #1b251f;                                       -fx-text-fill: white;                                       -fx-prompt-text-fill: #718077;                                       -fx-border-color: #35453a;                                       -fx-border-radius: 6;                                       -fx-background-radius: 6;                                       -fx-padding: 0 12;" />
                </VBox>

                <VBox maxWidth="420.0" spacing="6.0" />

                <HBox maxWidth="420.0" spacing="12.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Senha" textFill="#dce7df" />
                        <PasswordField fx:id="txtSenha" prefHeight="43.0" promptText="Crie uma senha" style="-fx-background-color: #1b251f;                                               -fx-text-fill: white;                                               -fx-prompt-text-fill: #718077;                                               -fx-border-color: #35453a;                                               -fx-border-radius: 6;                                               -fx-background-radius: 6;                                               -fx-padding: 0 10;" />
                    </VBox>

                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Confirmar senha" textFill="#dce7df" />
                        <PasswordField fx:id="txtConfirmarSenha" prefHeight="43.0" promptText="Repita a senha" style="-fx-background-color: #1b251f;                                               -fx-text-fill: white;                                               -fx-prompt-text-fill: #718077;                                               -fx-border-color: #35453a;                                               -fx-border-radius: 6;                                               -fx-background-radius: 6;                                               -fx-padding: 0 10;" />
                    </VBox>
                </HBox>

                <Button fx:id="btnCadastrar" maxWidth="420.0" onAction="#cadastrar" prefHeight="47.0" style="-fx-background-color: #42e878;                                -fx-text-fill: #101512;                                -fx-font-weight: bold;                                -fx-font-size: 13px;                                -fx-background-radius: 6;                                -fx-cursor: hand;" text="CRIAR MINHA CONTA" HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="Já possui uma conta?" textFill="#9ba89e" />
                    <Hyperlink fx:id="linkLogin" onAction="#voltarLogin" style="-fx-text-fill: #42e878;                                       -fx-border-color: transparent;" text="Fazer login" />
                </HBox>

            </VBox>
        </HBox>
    </children>
</AnchorPane>
