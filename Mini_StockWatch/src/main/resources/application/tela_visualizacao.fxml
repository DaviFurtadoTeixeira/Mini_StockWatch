<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor_visualizacao" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" stylesheets="@tabela.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.tela_controle_visualizacao">
   <children>
      <ImageView fx:id="imagem_background" fitHeight="1080.0" fitWidth="1920.0">
         <image>
            <Image url="@../imagens/imagem_tela_visualização.jpg" />
         </image>
      </ImageView>
      <ImageView fx:id="tela_escurecida" fitHeight="1080.0" fitWidth="1920.0" opacity="0.46" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/tela_preta.jpg" />
         </image>
      </ImageView>
      <Label fx:id="label_titulo" alignment="CENTER" layoutX="710.0" layoutY="45.0" prefHeight="70.0" prefWidth="500.0" style="-fx-background-color: #06A110; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4); -fx-border-color: #FFFFFF; -fx-border-radius: 15;" text="Controle e Visualização" textFill="WHITE">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      
      <!-- Barra de pesquisa mais compacta, elegante e centralizada -->
      <TextField fx:id="txt_pesquisa" layoutX="660.0" layoutY="135.0" prefHeight="45.0" prefWidth="600.0" promptText="🔍 Pesquisar produtos..." style="-fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #dcdcdc; -fx-background-color: #ffffff; -fx-padding: 0 15 0 15;">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>

      <!-- Tabela redimensionada para um tamanho equilibrado e centralizado -->
      <TableView fx:id="table_view" layoutX="260.0" layoutY="200.0" prefHeight="750.0" prefWidth="1400.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #e0e0e0; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 5);">
        <columns>
          <TableColumn fx:id="column_id" prefWidth="120.0" text="ID" />
          <TableColumn fx:id="column_nome" prefWidth="320.0" text="Nome" />
            <TableColumn fx:id="column_fornecedor" prefWidth="320.0" text="Fornecedor" />
            <TableColumn fx:id="column_tipo" prefWidth="240.0" text="Tipo" />
            <TableColumn fx:id="column_quantidade" minWidth="0.0" prefWidth="180.0" text="Quantidade" />
            <TableColumn fx:id="column_validade" prefWidth="218.0" text="Validade" />
        </columns>
      </TableView>
      <ImageView fx:id="logo_stockwatch" fitHeight="120.0" fitWidth="160.0" layoutX="30.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/Logo%20moderno%20StockWatch.png" />
         </image>
      </ImageView>
      <Button fx:id="button_cadastrar_produto" layoutX="1614.0" layoutY="1008.0" mnemonicParsing="false" onAction="#CadastroDeProduto" prefHeight="58.0" prefWidth="286.0" style="-fx-background-color: #000000; -fx-border-color: #FFFFFF; -fx-border-width: 2px; -fx-background-radius: 20; -fx-border-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(6,161,16,0.4), 10, 0, 0, 4);" text="Cadastro de Produtos" textFill="#21ff21">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
